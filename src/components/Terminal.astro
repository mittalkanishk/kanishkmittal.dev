---
import { Code } from 'astro:components';

/** Sample run and library snippet, based on the steerloop README. */
const trace: { kind: string; text: string }[] = [
  { kind: 'cmd', text: 'steerloop run --model anthropic:<model> --tools examples/tools.yaml \\' },
  { kind: 'cmd-more', text: '  "How many lines is README.md, and which files mention Registry?"' },
  { kind: 'meta', text: 'model anthropic:<model> · stop no-tool-calls · max 12 steps' },
  { kind: 'step', text: '[step 1]' },
  { kind: 'call', text: '  → count_lines {"path":"README.md"}' },
  { kind: 'result', text: '  ← count_lines: 180 README.md' },
  { kind: 'step', text: '[step 2]' },
  { kind: 'done', text: 'done: finished · 2 step(s) · 1482 tokens' },
  { kind: 'answer', text: 'README.md has 180 lines.' },
];

const library = `loop, err := steerloop.New(
	steerloop.DefaultConfig(), chatModel, tools, executor, nil,
)
if err != nil {
	return err
}

for evt := range loop.Start(ctx, messages) {
	switch data := evt.Data.(type) {
	case steerloop.ToolCallData:
		fmt.Println("tool call:", data.Name, data.Arguments)
	case steerloop.ToolResultData:
		fmt.Println("tool result:", data.Result)
	case steerloop.DoneData:
		fmt.Println(data.Reason, data.FinalContent)
	}
}

// From any other goroutine, while the run is in flight:
loop.Inject("Only count the Go files.")
loop.Stop()`;

const controls = [
  { input: 'any text', effect: 'Injected as a user message before the next model call.' },
  { input: '/stop', effect: 'Graceful stop.' },
  { input: '/max <n>  /temp <x>', effect: 'Change the configuration mid-run.' },
];
---

<div class="term panel" data-term>
  <div class="bar">
    <span class="lights" aria-hidden="true"><i></i><i></i><i></i></span>
    <div class="tabs" role="tablist" aria-label="steerloop examples">
      <button type="button" role="tab" id="tab-cli" aria-controls="pane-cli" aria-selected="true" data-tab>CLI</button>
      <button type="button" role="tab" id="tab-lib" aria-controls="pane-lib" aria-selected="false" tabindex="-1" data-tab>
        Library
      </button>
    </div>
    <button class="replay" type="button" data-term-replay>Replay</button>
  </div>

  <div class="pane" id="pane-cli" role="tabpanel" aria-labelledby="tab-cli" tabindex="0">
    <pre class="trace"><code>{trace.map((line) => <span class="line" data-kind={line.kind}>{line.text}</span>)}</code></pre>
    <p class="controls-intro">While it runs, type to steer it.</p>
    <dl class="controls">
      {
        controls.map((control) => (
          <div>
            <dt>{control.input}</dt>
            <dd>{control.effect}</dd>
          </div>
        ))
      }
    </dl>
  </div>

  <div class="pane" id="pane-lib" role="tabpanel" aria-labelledby="tab-lib" tabindex="0" hidden>
    <Code code={library} lang="go" themes={{ light: 'github-light', dark: 'github-dark' }} />
  </div>
</div>

<style>
  .term {
    display: flex;
    flex-direction: column;
    overflow: hidden;
    background: var(--surface-strong);
    font-family: var(--font-mono);
    font-size: 0.8rem;
    line-height: 1.7;
  }

  .bar {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 0.6rem 0.9rem;
    border-bottom: 1px solid var(--line);
  }

  .lights {
    display: flex;
    gap: 0.4rem;
  }

  .lights i {
    width: 0.6rem;
    height: 0.6rem;
    border-radius: 50%;
    background: var(--line-strong);
  }

  .tabs {
    display: flex;
    gap: 0.25rem;
    margin-right: auto;
  }

  .tabs button,
  .replay {
    padding: 0.25rem 0.7rem;
    border: 1px solid transparent;
    border-radius: 999px;
    background: none;
    color: var(--text-faint);
    font-size: 0.74rem;
    cursor: pointer;
  }

  .tabs button[aria-selected='true'] {
    border-color: var(--line);
    background: var(--inset);
    color: var(--text);
  }

  .replay {
    border-color: var(--line);
  }

  .replay:hover,
  .tabs button:hover {
    color: var(--text);
  }

  .pane {
    display: flex;
    flex: 1;
    flex-direction: column;
    min-height: 21rem;
    padding: 1.1rem 1.2rem 1.3rem;
  }

  .pane[hidden] {
    display: none;
  }

  pre {
    overflow-x: auto;
  }

  .pane :global(pre) {
    margin: 0;
    font-family: inherit;
    font-size: inherit;
    line-height: inherit;
    tab-size: 2;
  }

  .line {
    display: block;
    min-height: 1.7em;
    white-space: pre;
    color: var(--text-soft);
  }

  .line[data-kind='cmd'],
  .line[data-kind='cmd-more'] {
    color: var(--text);
  }

  .line[data-kind='cmd']::before {
    content: '$ ';
    color: var(--c-skills);
  }

  .line[data-kind='meta'] {
    margin-top: 0.5rem;
    color: var(--text-faint);
  }

  .line[data-kind='step'] {
    color: var(--c-projects);
  }

  .line[data-kind='call'] {
    color: var(--c-experience);
  }

  .line[data-kind='done'] {
    color: var(--c-skills);
  }

  .line[data-kind='answer'] {
    margin-bottom: 1.1rem;
    color: var(--text);
    font-weight: 500;
  }

  /* The script plays the lines one at a time. */
  :global(.js) [data-term].is-armed .line {
    opacity: 0;
    translate: 0 0.3rem;
    transition:
      opacity 0.3s ease,
      translate 0.3s ease;
  }

  :global(.js) [data-term].is-armed .line.is-on {
    opacity: 1;
    translate: 0 0;
  }

  /* Sits at the bottom, so any spare height reads as empty terminal rows. */
  .controls-intro {
    margin-top: auto;
    padding-top: 1rem;
    border-top: 1px dashed var(--line);
    color: var(--text-faint);
    font-size: 0.76rem;
  }

  .controls {
    display: grid;
    gap: 0.35rem;
    margin-top: 0.5rem;
    font-size: 0.76rem;
  }

  .controls div {
    display: grid;
    grid-template-columns: 10.5rem 1fr;
    gap: 0.75rem;
  }

  .controls dt {
    color: var(--c-education);
    white-space: pre;
  }

  .controls dd {
    color: var(--text-soft);
    font-family: var(--font-sans);
    font-size: 0.86rem;
    line-height: 1.5;
  }

  @media (max-width: 560px) {
    .term {
      font-size: 0.72rem;
    }

    .line {
      white-space: pre-wrap;
      overflow-wrap: anywhere;
    }

    .controls div {
      grid-template-columns: 1fr;
      gap: 0;
    }
  }
</style>

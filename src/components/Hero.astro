---
import { person } from '../data/profile';

const legend = [
  { label: 'Experience', href: '#experience', tone: 'experience' },
  { label: 'Projects', href: '#projects', tone: 'projects' },
  { label: 'Stack', href: '#skills', tone: 'skills' },
  { label: 'Education', href: '#education', tone: 'education' },
];
---

<section id="top" class="hero">
  <div class="container body">
    <p class="kicker" data-reveal>
      {person.role} · New Delhi · {person.timezone}
    </p>
    <h1 data-reveal data-clear style="--i: 1">{person.name}</h1>
    <p class="tagline" data-reveal data-clear style="--i: 2">{person.tagline}</p>
    <p class="intro" data-reveal data-clear style="--i: 3">{person.intro}</p>

    <div class="cta" data-reveal data-clear style="--i: 4">
      <a class="btn btn-primary" href="#projects">See the work</a>
      <a class="btn" href="#contact">Get in touch</a>
      <a class="btn" href={person.github} rel="me noopener">
        GitHub
        <svg viewBox="0 0 16 16" aria-hidden="true">
          <path d="M5 11 11 5M6 5h5v5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"></path>
        </svg>
      </a>
    </div>

    <p class="status" data-reveal data-clear style="--i: 5">
      <span class="beacon" aria-hidden="true"></span>
      {person.status}. {person.workStyle}
    </p>
  </div>

  <div class="container foot" data-reveal style="--i: 6">
    <ul class="legend" aria-label="Graph legend">
      {
        legend.map((item) => (
          <li>
            <a href={item.href} style={`--tone: var(--c-${item.tone})`}>
              <span class="swatch" />
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .hero {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: clamp(2rem, 6vh, 4rem);
    min-height: 100svh;
    padding-block: 7rem 2.5rem;
  }

  .body {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1.25rem;
    margin-block: auto;
  }

  .body > * {
    max-width: 38rem;
  }

  h1 {
    font-size: clamp(3.2rem, 10.5vw, 7.25rem);
    letter-spacing: -0.055em;
    line-height: 0.94;
  }

  .tagline {
    font-size: clamp(1.4rem, 3vw, 2.05rem);
    font-weight: 500;
    letter-spacing: -0.025em;
    line-height: 1.2;
    text-wrap: balance;
  }

  .intro {
    color: var(--text-soft);
    font-size: clamp(1.02rem, 1.4vw, 1.15rem);
  }

  .cta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-top: 0.5rem;
  }

  .status {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    color: var(--text-soft);
    font-size: 0.92rem;
  }

  .beacon {
    position: relative;
    flex: none;
    width: 0.55rem;
    height: 0.55rem;
    border-radius: 50%;
    background: var(--c-skills);
  }

  .beacon::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: inherit;
    animation: beacon 2.4s ease-out infinite;
  }

  @keyframes beacon {
    to {
      transform: scale(3.4);
      opacity: 0;
    }
  }

  .foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem 2rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--line);
    color: var(--text-faint);
    font-family: var(--font-mono);
    font-size: 0.76rem;
  }

  .legend {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1.4rem;
  }

  .legend a {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--text-soft);
    text-decoration: none;
  }

  .legend a:hover {
    color: var(--text);
  }

  .swatch {
    width: 0.55rem;
    height: 0.55rem;
    border-radius: 50%;
    background: var(--tone);
  }

  /* On narrow screens the graph gets the top of the screen to itself. */
  @media (max-width: 900px) {
    .hero {
      justify-content: flex-start;
      padding-top: 46svh;
    }

    .body {
      margin-block: 0;
    }

    :global(.no-webgl) .hero {
      padding-top: 7rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .beacon::after {
      animation: none;
    }
  }
</style>

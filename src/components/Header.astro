---
import { navLinks, person } from '../data/profile';
import ThemeToggle from './ThemeToggle.astro';
---

<header class="site-header" data-header>
  <div class="bar container">
    <a class="brand" href="#top" aria-label={`${person.name}, back to top`}>
      <svg class="mark" viewBox="0 0 24 24" aria-hidden="true">
        <path d="M6 17 12 6l6 9M6 17l12-2" fill="none" stroke="currentColor" stroke-width="1.4" opacity="0.55"></path>
        <circle cx="6" cy="17" r="2.4" fill="var(--c-skills)"></circle>
        <circle cx="12" cy="6" r="2.9" fill="var(--accent)"></circle>
        <circle cx="18" cy="15" r="2.4" fill="var(--c-projects)"></circle>
      </svg>
      <span>kanishkmittal<span class="tld">.dev</span></span>
    </a>

    <nav id="site-nav" class="nav" aria-label="Sections" data-nav>
      {navLinks.map((link) => <a href={link.href}>{link.label}</a>)}
    </nav>

    <div class="tools">
      <ThemeToggle />
      <button class="icon-btn menu" type="button" aria-expanded="false" aria-controls="site-nav" data-menu>
        <span class="sr-only">Menu</span>
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="M4 8h16M4 16h16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"></path>
        </svg>
      </button>
    </div>
  </div>
</header>

<style>
  .site-header {
    position: fixed;
    inset: 0 0 auto;
    z-index: 20;
    border-bottom: 1px solid transparent;
    transition:
      background-color 0.3s ease,
      border-color 0.3s ease;
  }

  .site-header.is-stuck,
  .site-header.is-open {
    border-bottom-color: var(--line);
    background: var(--surface);
    -webkit-backdrop-filter: blur(18px) saturate(150%);
    backdrop-filter: blur(18px) saturate(150%);
  }

  .bar {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    height: 4rem;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    margin-right: auto;
    font-family: var(--font-mono);
    font-size: 0.9rem;
    font-weight: 500;
    letter-spacing: -0.01em;
    text-decoration: none;
  }

  .mark {
    width: 1.5rem;
    height: 1.5rem;
  }

  .tld {
    color: var(--accent);
  }

  .nav {
    display: flex;
    gap: 0.25rem;
  }

  .nav a {
    padding: 0.4rem 0.75rem;
    border-radius: 999px;
    color: var(--text-soft);
    font-size: 0.9rem;
    text-decoration: none;
    transition:
      color 0.2s ease,
      background-color 0.2s ease;
  }

  .nav a:hover,
  .nav a[aria-current='true'] {
    color: var(--text);
    background: var(--inset);
  }

  .nav a[aria-current='true'] {
    box-shadow: inset 0 0 0 1px var(--line);
  }

  .tools {
    display: flex;
    gap: 0.4rem;
  }

  .tools :global(.icon-btn) {
    display: grid;
    place-items: center;
    width: 2.4rem;
    height: 2.4rem;
    padding: 0;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: var(--inset);
    cursor: pointer;
    transition: border-color 0.2s ease;
  }

  .tools :global(.icon-btn:hover) {
    border-color: var(--line-strong);
  }

  .tools :global(.icon-btn svg) {
    width: 1.1rem;
    height: 1.1rem;
  }

  .menu {
    display: none !important;
  }

  @media (max-width: 900px) {
    .menu {
      display: grid !important;
    }

    .nav {
      position: absolute;
      inset: 4rem 0 auto;
      display: none;
      flex-direction: column;
      gap: 0;
      padding: 0.5rem var(--gutter) 1rem;
      border-bottom: 1px solid var(--line);
      background: var(--surface-strong);
      -webkit-backdrop-filter: blur(18px);
      backdrop-filter: blur(18px);
    }

    .is-open .nav {
      display: flex;
    }

    .nav a {
      padding: 0.8rem 0.5rem;
      border-radius: 10px;
      font-size: 1rem;
    }
  }
</style>
